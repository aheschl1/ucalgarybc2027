UCBC_DATABASE_URL=postgresql://ucbc:ucbc@localhost:5432/ucbc
# The same user and password, for compose to create the database with.
POSTGRES_USER=ucbc
POSTGRES_PASSWORD=ucbc

# Blob storage (S3 API)
UCBC_BLOB_URL=http://ucbc:ucbcucbc@localhost:9000/ucbc
# The same keys, for compose to start MinIO with (at least 8 characters).
MINIO_ROOT_USER=ucbc
MINIO_ROOT_PASSWORD=ucbcucbc

# Read only by `ucbc-api-cli create-admin`; the API never creates users on its own.
UCBC_ADMIN_USERNAME=admin
UCBC_ADMIN_PASSWORD=admin
