# For running the API and worker from the checkout.
UCBC_DATABASE_URL=postgresql://ucbc:ucbc@localhost:5432/ucbc

# Compose: with COMPOSE_PROFILES=db it starts Postgres itself with these credentials.
# To reuse a Postgres you already have, leave COMPOSE_PROFILES empty and point POSTGRES_HOST
# at it (POSTGRES_PORT and POSTGRES_DB if not 5432 and the user's name); the role and
# database must already exist there. host.docker.internal is the machine running compose.
COMPOSE_PROFILES=db
POSTGRES_USER=ucbc
POSTGRES_PASSWORD=ucbc
#POSTGRES_HOST=host.docker.internal
#POSTGRES_PORT=5432
#POSTGRES_DB=ucbc

# Blob storage (S3 API)
UCBC_BLOB_URL=http://ucbc:ucbcucbc@localhost:9000/ucbc
# The same keys, for compose to start MinIO with (at least 8 characters).
MINIO_ROOT_USER=ucbc
MINIO_ROOT_PASSWORD=ucbcucbc

# Read only by `ucbc-api-cli create-admin`; the API never creates users on its own.
UCBC_ADMIN_USERNAME=admin
UCBC_ADMIN_PASSWORD=admin
