UCBC_DATABASE_URL=postgresql://ucbc:ucbc@localhost:5432/ucbc
# Compose starts Postgres with these. To reuse an existing one, empty COMPOSE_PROFILES and
# set POSTGRES_HOST (role and database must exist; host.docker.internal is this machine).
COMPOSE_PROFILES=db
POSTGRES_USER=ucbc
POSTGRES_PASSWORD=ucbc
#POSTGRES_HOST=host.docker.internal
#POSTGRES_PORT=5432
#POSTGRES_DB=ucbc

# Blob storage (S3 API)
UCBC_BLOB_URL=http://ucbc:ucbcucbc@localhost:9000/ucbc
# The same keys, for compose to start MinIO with (at least 8 characters).
MINIO_ROOT_USER=ucbc
MINIO_ROOT_PASSWORD=ucbcucbc

# Read only by `ucbc-api-cli create-admin`; the API never creates users on its own.
UCBC_ADMIN_EMAIL=admin@example.com
UCBC_ADMIN_PASSWORD=admin

# Host address compose publishes ports on (default: every interface), and MinIO's host
# ports, for when 9000/9001 are taken.
#UCBC_BIND=10.8.0.1
#MINIO_PORT=9000
#MINIO_CONSOLE_PORT=9001
