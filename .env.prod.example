# Production, layered over .env by `ENV=prod`.
UCBC_RESTART=unless-stopped
# Published on loopback only: a tunnel or reverse proxy on the host is the way in, and it
# terminates TLS (the session cookie is Secure, so plain http to a non-localhost name fails).
UCBC_BIND=127.0.0.1
# Every request arrives from that proxy, so trust its X-Forwarded-For.
UCBC_FORWARDED_ALLOW_IPS=*
UCBC_WORKER_SLOTS=2

# Generate each secret: openssl rand -hex 24
COMPOSE_PROFILES=db
POSTGRES_USER=ucbc
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=ucbc
MINIO_ROOT_PASSWORD=change-me

# Read only by `ucbc-api-cli create-admin`.
UCBC_ADMIN_EMAIL=admin@example.com
UCBC_ADMIN_PASSWORD=change-me
