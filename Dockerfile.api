# syntax=docker/dockerfile:1

FROM node:22-alpine AS web
WORKDIR /src
COPY package.json package-lock.json tsconfig.base.json ./
COPY --parents ucbc-web/package.json ucbc-viewer/package.json games/*/*/package.json ./
RUN --mount=type=cache,target=/root/.npm npm ci
COPY games/ games/
COPY ucbc-games/Cargo.toml ucbc-games/
COPY ucbc-viewer/ ucbc-viewer/
COPY ucbc-web/ ucbc-web/
RUN npm run build -w ucbc-web -- --outDir /out --emptyOutDir

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PATH="/app/.venv/bin:$PATH"
RUN useradd --create-home api
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY --parents ucbc-cli/pyproject.toml ucbc-api/pyproject.toml ucbc-worker/pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package ucbc-api --no-install-workspace
COPY ucbc-api/ ucbc-api/
COPY alembic.ini ./
COPY alembic/ alembic/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package ucbc-api
COPY --from=web /out ucbc-api/api/static

USER api
EXPOSE 8000
CMD ["ucbc-api"]
