# syntax=docker/dockerfile:1.20

# The web app, built once. UCBC_GAMES (empty: every game) picks the bundled viewer renderers.
# Renderers are found by path, `games/*/viewer`, so a new game needs no edit here.
FROM node:22-alpine AS web
ARG UCBC_GAMES=
ENV UCBC_GAMES=$UCBC_GAMES
WORKDIR /src
COPY --parents package.json package-lock.json tsconfig.base.json ucbc-viewer/package.json \
    ucbc-web/package.json games/*/viewer/package.json ./
RUN npm ci
COPY --parents ucbc-viewer ucbc-web games/*/viewer ./
RUN npm run build -w ucbc-web -- --outDir /out --emptyOutDir

# The API, serving the web app at / and itself at /api.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app

# uv reads every workspace member's manifest; only ucbc-api is installed.
COPY pyproject.toml uv.lock ./
COPY ucbc-sdk/pyproject.toml ucbc-sdk/
COPY ucbc-py/pyproject.toml ucbc-py/
COPY ucbc-worker/pyproject.toml ucbc-worker/
COPY ucbc-api/ ucbc-api/
COPY alembic.ini ./
COPY alembic/ alembic/
RUN uv sync --frozen --no-dev --package ucbc-api
COPY --from=web /out ucbc-api/api/static

RUN useradd --create-home api && chown -R api:api /app
USER api
EXPOSE 8000
CMD ["ucbc-api"]
