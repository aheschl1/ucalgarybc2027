# The worker plays matches with `ucbc run`, so its environment holds the engine wheel,
# built here from source with the Rust toolchain, with ucbc-games' default games.
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PATH="/root/.cargo/bin:/app/.venv/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl ca-certificates \
    && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY pyproject.toml uv.lock Cargo.toml Cargo.lock ./
COPY ucbc-engine/ ucbc-engine/
COPY ucbc-games/ ucbc-games/
COPY games/ games/
COPY ucbc-dev/ ucbc-dev/
COPY ucbc-py/ ucbc-py/
COPY ucbc-sdk/ ucbc-sdk/
COPY ucbc-api/ ucbc-api/
COPY ucbc-worker/ ucbc-worker/
RUN uv sync --frozen --no-dev --package ucbc-worker

RUN useradd --create-home worker && chown -R worker:worker /app
USER worker
CMD ["ucbc-worker"]
