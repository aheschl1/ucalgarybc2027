# syntax=docker/dockerfile:1

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS engine

ENV PATH="/root/.cargo/bin:$PATH"
RUN apt-get update && apt-get install -y --no-install-recommends build-essential curl ca-certificates \
    && curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain none \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src

COPY rust-toolchain.toml ./
RUN rustup toolchain install

COPY Cargo.toml Cargo.lock Makefile ./
COPY ucbc-engine/ ucbc-engine/
COPY ucbc-games/ ucbc-games/
COPY games/ games/
COPY ucbc-dev/ ucbc-dev/
COPY ucbc-wasm/ ucbc-wasm/
COPY ucbc-cli/ ucbc-cli/

RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/root/.cargo/git \
    --mount=type=cache,target=/src/target \
    --mount=type=cache,target=/src/.cache \
    --mount=type=cache,target=/root/.cache/uv \
    make runtime && MATURIN_PEP517_ARGS="--profile dist" uv build --wheel ucbc-cli --out-dir /wheels

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ENV UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 PATH="/app/.venv/bin:$PATH"
RUN useradd --create-home worker
WORKDIR /app

COPY pyproject.toml uv.lock ./
COPY --parents ucbc-cli/pyproject.toml ucbc-api/pyproject.toml ucbc-worker/pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package ucbc-worker --no-install-workspace
COPY ucbc-api/ ucbc-api/
COPY ucbc-worker/ ucbc-worker/
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --package ucbc-worker --no-install-package ucbc
COPY --from=engine /wheels /wheels
RUN uv pip install --no-deps /wheels/*.whl && rm -rf /wheels

USER worker
CMD ["ucbc-worker"]
